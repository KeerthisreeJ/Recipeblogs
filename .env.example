# ==========================================
# KITTYEATS — ENVIRONMENT CONFIGURATION
# ==========================================

# --- Backend Configuration (backend/.env) ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/kittyeats

# JWT Authentication Secret
JWT_SECRET=kittyeats_secret_key_8b0000_delicious_recipes_2026
JWT_EXPIRES_IN=30d

# Cloudinary Storage (Optional)
# If left blank, Kittyeats automatically falls back to local disk storage in backend/uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend Configuration (frontend/.env - Optional) ---
# Default is empty because Vite proxies /api directly to http://localhost:5000
# VITE_API_BASE_URL=http://localhost:5000
